# C2S production — env var names only. Fill values ONLY in Vercel's
# dashboard (Settings > Environment Variables), then Redeploy.
# NEVER commit real secrets, and NEVER send a key in chat.
# Legacy identifiers from preview mode (not sufficient alone for live OTP):
# OTP_PROVIDER_SMS= OTP_PROVIDER_WHATSAPP= OTP_PROVIDER_EMAIL=

# (a) Database — free Supabase project (see README live steps).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Your own random string, used to hash OTPs. Set it before live use.
OTP_SALT=

# (b) OTP providers — set only the channels you actually want.
# SMS via MSG91:
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# ...or a generic SMS HTTP endpoint instead of MSG91:
SMS_API_URL=
SMS_API_KEY=
# WhatsApp via Meta WhatsApp Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
# Email via Resend:
RESEND_API_KEY=
EMAIL_FROM=

# (c) Payments — only when actually taking payments.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=

# Videos (deferred phase) — object storage + CDN, not Vercel disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
CDN_URL=
ANALYTICS_ID=
